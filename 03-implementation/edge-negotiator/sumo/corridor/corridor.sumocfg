<?xml version="1.0" encoding="UTF-8"?>
<!-- Arterial-corridor headroom substrate for the predictive-coordination study.
     4 signalised crossroads on a straight arterial; platooned through-demand.
     time-to-teleport disabled so gridlock shows as honest delay, not vanished
     vehicles (matches the grid2x2 discipline). -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="corridor.net.xml"/>
        <route-files value="corridor.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>
    <processing>
        <time-to-teleport value="-1"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <no-warnings value="true"/>
    </report>
</configuration>
