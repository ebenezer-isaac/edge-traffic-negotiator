<?xml version="1.0" encoding="UTF-8"?>
<!-- GUI-only view settings for the live emergency demo. Visual presentation
     only: vehicles are drawn larger and the event captions (POIs) and junction
     names are shown so the story reads on one screen while recording. This file
     is never loaded in headless runs and has no effect on the simulation or any
     measured metric. Tune sizes here, or via Edit > Edit Visualization in the
     GUI. -->
<viewsettings>
    <scheme name="standard"/>
    <delay value="120"/>
    <vehicles vehicleSize.exaggeration="5.00" vehicleSize.minSize="1.00" vehicleName_show="0"/>
    <junctions junctionName_show="1" junctionName_size="120.00" junctionName_color="40,40,40"/>
    <pois poiName_show="1" poiName_size="120.00" poiName_color="10,10,10"/>
</viewsettings>
